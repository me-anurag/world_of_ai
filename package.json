{
  "name": "atlas-of-ai",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "data": "node scripts/run-python.mjs scripts/check_and_build_data.py && node scripts/prepare-data.mjs",
    "lint:content": "node scripts/lint-content.mjs",
    "dev": "npm run data && astro dev",
    "build": "npm run data && npm run lint:content && astro build && pagefind --site dist && node scripts/lint-site.mjs",
    "preview": "astro preview",
    "verify:papers": "npm run data && node scripts/verify-papers.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "astro": "^5.18.2",
    "pagefind": "^1.6.0"
  }
}
