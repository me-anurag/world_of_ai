---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/400-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { site } from '../site.config.mjs';
import Sidebar from '../components/Sidebar.astro';
import SearchDialog from '../components/SearchDialog.astro';

interface Props {
  title: string;            // page name, without the site name
  description: string;      // one sentence for search results and link previews
  current?: string;         // node id of the page, for the contents sidebar
  section?: string;         // which top-level section is active in the header
  wide?: boolean;           // no sidebar
  jsonld?: object;
  noindex?: boolean;
}
const { title, description, current, section, wide = false, jsonld, noindex = false } = Astro.props;
const fullTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const nav = [
  ['fields', 'Fields', '/fields/'],
  ['timeline', 'Timeline', '/timeline/'],
  ['papers', 'Papers', '/papers/'],
  ['glossary', 'Glossary', '/glossary/'],
  ['guide', 'Guide', '/guide/'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og.png', site.url).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${site.name}: a map of artificial intelligence`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={new URL('/og.png', site.url).href} />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#161920" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header" data-pagefind-ignore>
    <div class="in">
      <a class="brand" href="/">{site.name}{site.beta && <span class="beta">Beta</span>}</a>
      <nav class="nav" aria-label="Sections">
        {nav.map(([key, label, href]) => <a href={href} aria-current={section === key ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="header-tools">
        <button class="search-trigger" type="button" id="search-open" aria-haspopup="dialog">
          <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>Search<span class="label-long"> topics and papers</span></span><kbd>/</kbd>
        </button>
        <button class="icon-btn" type="button" id="theme-toggle" aria-label="Switch colour theme" title="Switch colour theme">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>
  </header>

  <div class={`frame${wide ? ' wide' : ''}`}>
    {!wide && <Sidebar current={current} />}
    <main id="main" class="content">
      <slot />
    </main>
  </div>

  <footer class="site-footer" data-pagefind-ignore>
    <div class="in">
      <span class="grow">{site.name}. Text and data under CC BY 4.0. Last updated {site.updated}.</span>
      <a href="/methodology/">Methodology</a>
      <a href="/changelog/">Changelog</a>
      <a href="/data/">Download the data</a>
      <a href="/about/">About</a>
      <a href={`https://github.com/${site.repo}`}>Source on GitHub</a>
    </div>
  </footer>

  <SearchDialog />

  <script>
    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      const next = dark ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  </script>
</body>
</html>
