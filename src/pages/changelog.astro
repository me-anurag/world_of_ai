---
import Base from '../layouts/Base.astro';
---
<Base title="Changelog" description="Every change to the map, newest first." section="guide" wide>
  <div class="prose" style="max-width:760px">
    <h1>Changelog</h1>
    <p class="lead">Changes to the map, newest first. Corrections credit the person who reported them unless they ask otherwise.</p>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th scope="col" style="width:8em">Date</th><th scope="col">Change</th></tr></thead>
        <tbody>
          <tr><td>2026-11-06</td><td>Public launch as World of AI. 1,505 topics in 15 fields, with learning paths, timeline, key papers and glossary. Topics are marked as not yet reviewed.</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</Base>
